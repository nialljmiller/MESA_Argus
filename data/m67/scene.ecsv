# %ECSV 1.0
# ---
# datatype:
# - name: Source
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release) (source_id)
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 19}
# - name: RA_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Right ascension (ICRS) at Ep=2016.0 (ra)
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: DE_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Declination (ICRS) at Ep=2016.0 (dec)
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: Plx
#   unit: mas
#   datatype: float64
#   format: '{:9.4f}'
#   description: '? Parallax (parallax)'
#   meta: !!omap
#   - {ucd: POS_PARLX_TRIG}
#   - {width: 9}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.3f}'
#   description: '? Proper motion in right ascension direction, pmRA*cosDE (pmra)'
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 9}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:9.3f}'
#   description: '? Proper motion in declination direction (pmdec)'
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 9}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Gmag
#   unit: mag
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? G-band mean magnitude (phot_g_mean_mag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_OPTICAL}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: BPmag
#   unit: mag
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Integrated BP mean magnitude (phot_bp_mean_mag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_B}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: RPmag
#   unit: mag
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? Integrated RP mean magnitude (phot_rp_mean_mag)'
#   meta: !!omap
#   - {ucd: PHOT_MAG_R}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: BP-RP
#   unit: mag
#   datatype: float64
#   format: '{:9.6f}'
#   description: '? BP-RP colour (bp_rp)'
#   meta: !!omap
#   - {ucd: PHOT_CI_B-R}
#   - {width: 9}
#   - {precision: '6'}
#   - values: {'null': .nan}
# - name: RUWE
#   datatype: float64
#   format: '{:7.3f}'
#   description: '? Renormalised unit weight error (ruwe)'
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 7}
#   - {precision: '3'}
#   - values: {'null': .nan}
# - name: Teff
#   unit: K
#   datatype: float64
#   format: '{:7.1f}'
#   description: '? Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra (teff_gspphot)'
#   meta: !!omap
#   - {ucd: PHYS_TEMP_EFFEC}
#   - {width: 7}
#   - {precision: '1'}
#   - values: {'null': .nan}
# - name: logg
#   unit: log(cm.s**-2)
#   datatype: float64
#   format: '{:7.4f}'
#   description: '? Surface gravity from GSP-Phot Aeneas best library using BP/RP spectra (logg_gspphot)'
#   meta: !!omap
#   - {ucd: PHYS_GRAVITY_SURFACE}
#   - {width: 7}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - name: '[Fe/H]'
#   datatype: float64
#   format: '{:7.4f}'
#   description: '? Iron abundance from GSP-Phot Aeneas best library using BP/RP spectra (mh_gspphot)'
#   meta: !!omap
#   - {ucd: PHYS_ABUND_FE/H}
#   - {width: 7}
#   - {precision: '4'}
#   - values: {'null': .nan}
# - {name: P, datatype: float64}
# - {name: member, datatype: bool}
# - {name: dx_arcsec, datatype: float64}
# - {name: dy_arcsec, datatype: float64}
# - {name: in_block, datatype: bool}
