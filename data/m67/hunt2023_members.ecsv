# %ECSV 1.0
# ---
# datatype:
# - name: recno
#   datatype: int32
#   description: Record number assigned by the VizieR team. Should Not be used for identification.
#   meta: !!omap
#   - {ucd: RECORD}
#   - {width: 8}
# - name: Name
#   datatype: string
#   description: Main accepted cluster name
#   meta: !!omap
#   - {ucd: ID_PARENT}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: 20*}
# - name: ID
#   datatype: int16
#   description: '? Internal cluster ID'
#   meta: !!omap
#   - {ucd: ID_IDENTIFIER}
#   - {width: 4}
#   - values: {'null': -32768}
# - name: GaiaDR3
#   datatype: int64
#   description: Gaia DR3 source ID
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {width: 19}
# - name: inrt
#   datatype: string
#   description: Flag indicating if cluster is within tidal radius (i.e. is a good member)
#   meta: !!omap
#   - {ucd: CODE_MISC}
#   - {_votable_string_dtype: char}
# - name: Prob
#   datatype: float64
#   format: '{:21.18f}'
#   description: '[0/1] Membership probability'
#   meta: !!omap
#   - {ucd: STAT_PROBABILITY}
#   - {width: 21}
#   - {precision: '18'}
# - name: RA_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Right ascension of star (ICRS) at Ep=2016.0
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: e_RA_ICRS
#   unit: arcsec
#   datatype: float64
#   format: '{:22.19f}'
#   description: Standard error on RA
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 22}
#   - {precision: '19'}
# - name: DE_ICRS
#   unit: deg
#   datatype: float64
#   format: '{:15.11f}'
#   description: Declination of star (ICRS) at Ep=2016.0
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
#   - {width: 15}
#   - {precision: '11'}
# - name: e_DE_ICRS
#   unit: arcsec
#   datatype: float64
#   format: '{:22.19f}'
#   description: Standard error on DE
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 22}
#   - {precision: '19'}
# - name: GLON
#   unit: deg
#   datatype: float64
#   format: '{:24.20f}'
#   description: Galactic longitude
#   meta: !!omap
#   - {ucd: POS_GAL_LON}
#   - {width: 24}
#   - {precision: '20'}
# - name: GLAT
#   unit: deg
#   datatype: float64
#   format: '{:24.17g}'
#   description: Galactic latitude
#   meta: !!omap
#   - {ucd: POS_GAL_LAT}
#   - {width: 24}
#   - {precision: E17}
# - name: pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:24.17g}'
#   description: Mean proper motion in right ascension multipled by cos(dec)
#   meta: !!omap
#   - {ucd: POS_EQ_PMRA}
#   - {width: 24}
#   - {precision: E17}
# - name: e_pmRA
#   unit: mas / yr
#   datatype: float64
#   format: '{:22.19f}'
#   description: Standard error of pmRA
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 22}
#   - {precision: '19'}
# - name: pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:24.17g}'
#   description: Mean proper motion in declination
#   meta: !!omap
#   - {ucd: POS_EQ_PMDEC}
#   - {width: 24}
#   - {precision: E17}
# - name: e_pmDE
#   unit: mas / yr
#   datatype: float64
#   format: '{:21.18f}'
#   description: Standard error of pmDE
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 21}
#   - {precision: '18'}
# - name: Plx
#   unit: mas
#   datatype: float64
#   format: '{:24.17g}'
#   description: Mean parallax
#   meta: !!omap
#   - {ucd: POS_PARLX_TRIG}
#   - {width: 24}
#   - {precision: E17}
# - name: e_Plx
#   unit: mas
#   datatype: float64
#   format: '{:21.18f}'
#   description: Standard error of parallax
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 21}
#   - {precision: '18'}
# - name: pscol
#   unit: 1 / um
#   datatype: float64
#   format: '{:19.16f}'
#   description: '? Estimated pseudocolour'
#   meta: !!omap
#   - {ucd: FIT_PARAM_VALUE}
#   - {width: 19}
#   - {precision: '16'}
#   - values: {'null': .nan}
# - name: e_pscol
#   unit: 1 / um
#   datatype: float64
#   format: '{:22.19f}'
#   description: '? Standard error on pseudocolor'
#   meta: !!omap
#   - {ucd: ERROR}
#   - {width: 22}
#   - {precision: '19'}
#   - values: {'null': .nan}
# - name: PlxpmRACor
#   datatype: float64
#   format: '{:24.17g}'
#   description: Correlation between parallax and pmRA
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
#   - {precision: E17}
# - name: PlxpmDECor
#   datatype: float64
#   format: '{:24.17g}'
#   description: Correlation between parallax and pmDE
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
#   - {precision: E17}
# - name: pmRApmDECor
#   datatype: float64
#   format: '{:24.17g}'
#   description: Correlation between pmRA and pmdE
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
#   - {precision: E17}
# - name: PlxpscolCor
#   datatype: float64
#   format: '{:24.17g}'
#   description: '? Correlation between parallax and pseudocolour'
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
#   - {precision: E17}
#   - values: {'null': .nan}
# - name: pmRApscolCor
#   datatype: float64
#   format: '{:24.17g}'
#   description: '? Correlation between pmRA and pseudocolour'
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
#   - {precision: E17}
#   - values: {'null': .nan}
# - name: pmDEpscolCor
#   datatype: float64
#   format: '{:24.17g}'
#   description: '? Correlation between pmDE and pseudocolour'
#   meta: !!omap
#   - {ucd: STAT_CORRELATION}
#   - {width: 24}
